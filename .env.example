# CalmPop AI Wellbeing Companion - Environment Configuration
# Copy this file to .env and configure your desired AI provider.

# ===================================================================
# Primary Option: OpenRouter (NVIDIA Nemotron, Claude, Llama, etc.)
# Get a key at: https://openrouter.ai/keys
# ===================================================================
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your_openrouter_api_key_here
AI_MODEL=nvidia/nemotron-3.5-lightning

# ===================================================================
# Secondary Option: Google Gemini API
# Get a key at: https://aistudio.google.com/app/apikey
# ===================================================================
# GEMINI_API_KEY=your_gemini_api_key_here
# AI_MODEL=gemini-2.5-flash

# ===================================================================
# Tertiary Option: OpenAI API
# Get a key at: https://platform.openai.com/api-keys
# ===================================================================
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
